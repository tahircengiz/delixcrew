diff --git a/.github/workflows/site.yml b/.github/workflows/site.yml
new file mode 100644
index 0000000..161b50f
--- /dev/null
+++ b/.github/workflows/site.yml
@@ -0,0 +1,46 @@
+name: site
+on:
+  push:
+    branches: [main]
+    paths: ["site/**", ".claude-plugin/plugin.json", "tests/site_tests.sh", ".github/workflows/site.yml"]
+  pull_request:
+    paths: ["site/**", ".claude-plugin/plugin.json", "tests/site_tests.sh", ".github/workflows/site.yml"]
+  workflow_dispatch:
+permissions:
+  contents: read
+jobs:
+  check:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 5
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+      - name: Site tests
+        run: bash tests/site_tests.sh
+  deploy:
+    # Only main publishes; pull requests stop at the check job
+    if: github.event_name != 'pull_request' && github.ref == 'refs/heads/main'
+    needs: check
+    runs-on: ubuntu-24.04
+    timeout-minutes: 10
+    permissions:
+      contents: read
+      pages: write
+      id-token: write
+    concurrency:
+      group: pages
+      cancel-in-progress: false
+    environment:
+      name: github-pages
+      url: ${{ steps.deployment.outputs.page_url }}
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+      - uses: actions/configure-pages@45bfe0192ca1faeb007ade9deae92b16b8254a0d # v6.0.0
+      - uses: actions/upload-pages-artifact@fc324d3547104276b827a68afc52ff2a11cc49c9 # v5.0.0
+        with:
+          path: site
+      - id: deployment
+        uses: actions/deploy-pages@368f82528645a54fb793d4d04e342629a3f51346 # v5.0.1
diff --git a/CLAUDE.md b/CLAUDE.md
new file mode 100644
index 0000000..d783ab8
--- /dev/null
+++ b/CLAUDE.md
@@ -0,0 +1,16 @@
+# delixcrew repo notes
+
+## Site (GitHub Pages)
+
+`site/` is the public site: plain HTML and CSS, no build step, published by `.github/workflows/site.yml` on every push
+to main. Four pages, one per language and topic: `index.html` and `usage.html` (English), `tr/index.html` and
+`tr/usage.html` (Turkish). The English and Turkish pages carry the same content.
+
+Update the site in the same change when:
+- the version in `.claude-plugin/plugin.json` changes: every `data-version` mark and its `delixcrew <version>` text,
+  and the "coming in" / "ile gelecek" labels that the release turns into shipped features;
+- a command, hook rule, role, gate or project file is added, removed or renamed (README Flow, Roles, Files, Known limits).
+
+`bash tests/site_tests.sh` fails when a page's version differs from `plugin.json`, a TR/EN twin is missing, a page loads
+a script or a third-party asset, or a local link, anchor or icon does not resolve. Every claim on the site comes from a
+repo file; each section names its sources in its `Source:` / `Kaynak:` line.
